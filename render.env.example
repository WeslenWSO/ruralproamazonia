# Cole estas variáveis no Render: Web Service -> Environment
# DATABASE_URL: use "Link Database" ou Internal URL do Postgres

DEBUG=False
PYTHON_VERSION=3.12.8
DJANGO_SETTINGS_MODULE=config.settings
ALLOWED_HOSTS=ruralproamazonia.onrender.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://ruralproamazonia.onrender.com
SITE_BASE_URL=https://ruralproamazonia.onrender.com
SITE_DOMAIN=ruralproamazonia.onrender.com
GEMINI_MODEL=gemini-3.5-flash
SELENIUM_HEADLESS=True

# Preencher manualmente (Secret):
# DATABASE_URL=postgresql://...  (Internal Database URL do Postgres)
# SECRET_KEY=...                 (gere uma chave aleatoria longa)
# GEMINI_API_KEY=...
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Build Command:
# pip install -r requirements.txt && python manage.py collectstatic --no-input && python manage.py migrate --no-input

# Start Command:
# gunicorn config.wsgi:application --bind 0.0.0.0:$PORT
