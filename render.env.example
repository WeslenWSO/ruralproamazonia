# Cole estas variáveis no Render: Web Service -> Environment
# DATABASE_URL: use "Link Database" ou Internal URL do Postgres

DEBUG=False
PYTHON_VERSION=3.12.8
DJANGO_SETTINGS_MODULE=config.settings
ALLOWED_HOSTS=ruralproamazonia.onrender.com,www.ruralproamazonia.com.br,ruralproamazonia.com.br,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://ruralproamazonia.onrender.com,https://www.ruralproamazonia.com.br,https://ruralproamazonia.com.br
SITE_BASE_URL=https://www.ruralproamazonia.com.br
SITE_DOMAIN=www.ruralproamazonia.com.br
GEMINI_MODEL=gemini-3.5-flash
SELENIUM_HEADLESS=True

# Preencher manualmente (Secret):
# DATABASE_URL=postgresql://...  (Internal Database URL do Postgres)
# SECRET_KEY=...                 (gere uma chave aleatoria longa)
# ADMIN_PASSWORD=...             (senha do /admin/ — usuario admin)
# GEMINI_API_KEY=...
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Build Command:
# pip install -r requirements.txt && python manage.py collectstatic --no-input && python manage.py migrate --no-input && python manage.py atualizar_site

# Apos o primeiro deploy (Shell do Render):
# defina ADMIN_PASSWORD no painel e rode:
# python manage.py definir_senha_admin
# ou: python manage.py configurar_producao

# Start Command:
# gunicorn config.wsgi:application --bind 0.0.0.0:$PORT
