SECRET_KEY=sua-chave-secreta-aqui
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.17

# Domínio do site (usado pelo login social)
SITE_DOMAIN=127.0.0.1:8000

# Google OAuth — https://console.cloud.google.com/
# URIs autorizados: http://127.0.0.1:8000/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth — https://developers.facebook.com/
# URI de redirecionamento: http://127.0.0.1:8000/accounts/facebook/login/callback/
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Apple Sign In — https://developer.apple.com/
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# WhatsApp Cloud API (Meta) — envio automático do clima
# https://developers.facebook.com/docs/whatsapp/cloud-api/
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Google Gemini — parecer socioambiental BuscarRural (https://aistudio.google.com/apikey)
# Nunca commite a chave real; mantenha apenas no .env local.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# OpenAI — diagnóstico técnico BuscarRural (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PARECER_IA_PROVIDER=openai

# URL pública do site (para link da imagem do card na API)
SITE_BASE_URL=http://127.0.0.1:8000

# --- Render (produção) — configure no painel, não no Git ---
# DATABASE_URL=          # injetado automaticamente pelo render.yaml
# DEBUG=False
# ALLOWED_HOSTS=seu-app.onrender.com
# CSRF_TRUSTED_ORIGINS=https://seu-app.onrender.com
# SITE_BASE_URL=https://seu-app.onrender.com
# SITE_DOMAIN=seu-app.onrender.com
# RENDER=true            # definido automaticamente pelo Render
